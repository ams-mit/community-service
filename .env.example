# Azure MySQL Cloud Environment Configuration Template
SPRING_PROFILES_ACTIVE=mysql
SPRING_DATASOURCE_URL=jdbc:mysql://your-azure-mysql-server.mysql.database.azure.com:3306/community_db?useSSL=true&requireSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=amsadmin
SPRING_DATASOURCE_PASSWORD=your_azure_password_here

# Server & Port Configuration
PORT=8085
SERVER_PORT=8085

# Gateway JWT Security Configuration
JWT_SECURITY_ENABLED=true
GATEWAY_JWT_PUBLIC_KEY=
